{
  "rewrites": [
    { "source": "/api/:path*",          "destination": "https://gearshare-backend.onrender.com/api/:path*" },
    { "source": "/oauth2/:path*",       "destination": "https://gearshare-backend.onrender.com/oauth2/:path*" },
    { "source": "/login/oauth2/:path*", "destination": "https://gearshare-backend.onrender.com/login/oauth2/:path*" },
    { "source": "/auth/decide",         "destination": "https://gearshare-backend.onrender.com/auth/decide" },
    { "source": "/succesful-payment",   "destination": "https://gearshare-backend.onrender.com/succesful-payment" },
    { "source": "/:path*",              "destination": "/index.html" }
  ]
}
